{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Authentication": {
    "Jwt": {
      "Issuer": "identity-api",
      "Audience": "identity-api-clients",
      "SigningKey": ""
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:49913"
    ]
  },

  "OpenApiAggregation": {
    "Title": "API Gateway",
    "Version": "v1",
    "Description": "Aggregated OpenAPI across proxied services.",
    "CacheSeconds": 30,
    "Sources": [
      {
        "Name": "Identity",
        "OpenApiUrl": "https://localhost:5001/openapi/v1.json",
        "PathMap": {
          "/api/Auth": "/identity/auth",
          "/api/Users": "/identity/users",
          "/api/admin": "/identity/admin"
        }
      },
      {
        "Name": "Music",
        "OpenApiUrl": "https://localhost:5005/openapi/v1.json",
        "PathMap": {
          "/api/Uploads": "/music/uploads",
          "/api": "/music"
        }
      },
      {
        "Name": "Orders",
        "OpenApiUrl": "https://localhost:5004/openapi/v1.json",
        "PathMap": {
          "/api": "/orders"
        }
      }
    ]
  },

  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "burst-per-ip",
        "CorsPolicy": "gateway-cors",
        "Match": {
          "Path": "/identity/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/Auth/{**catch-all}" }
        ]
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "fixed-per-user",
        "CorsPolicy": "gateway-cors",
        "Match": {
          "Path": "/identity/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/Users/{**catch-all}" }
        ]
      },
      "identity-admin-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "fixed-per-user",
        "CorsPolicy": "gateway-cors",
        "Match": {
          "Path": "/identity/admin/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/admin/{**catch-all}" }
        ]
      },

      "music-uploads-route": {
        "ClusterId": "music-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "uploads",
        "CorsPolicy": "gateway-cors",
        "Match": {
          "Path": "/music/uploads/{**catch-all}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathPattern": "/api/Uploads/{**catch-all}" }
        ]
      },
      "music-write-route": {
        "ClusterId": "music-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "fixed-per-user",
        "CorsPolicy": "gateway-cors",
        "Match": {
          "Path": "/music/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "music-read-route": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "burst-per-ip",
        "CorsPolicy": "gateway-cors",
        "Match": {
          "Path": "/music/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "music-uploads-static-route": {
        "ClusterId": "music-cluster",
        "RateLimiterPolicy": "burst-per-ip",
        "CorsPolicy": "gateway-cors",
        "Match": {
          "Path": "/uploads/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },

      "orders-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "fixed-per-user",
        "CorsPolicy": "gateway-cors",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "primary": { "Address": "https://localhost:5001/" }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      },
      "music-cluster": {
        "Destinations": {
          "primary": { "Address": "https://localhost:5005/" }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      },
      "orders-cluster": {
        "Destinations": {
          "primary": { "Address": "https://localhost:5004/" }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  }
}
